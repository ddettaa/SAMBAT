# Template (tracked). Salin jadi .env lalu isi kredensil asli — .env di-ignore Git.
# SAMBAT_SOCIAL_ACCOUNT tanpa "@". Username/password hanya dipakai saat --login.
SAMBAT_SOCIAL_ACCOUNT=SAMBAT_BJM
SAMBAT_API_URL=http://127.0.0.1:3001

# WAJIB — harus sama persis dengan COLLECTOR_API_KEY di apps/api/.env
# (API memverifikasi SHA-256 key ini terhadap tabel api_keys).
COLLECTOR_API_KEY=

# Penyimpanan profile sesi persisten CloakBrowser (per-source) + backup state JSON.
# Default otomatis:
#   Linux/macOS: /var/lib/sambat/browser
#   Windows:     %LOCALAPPDATA%\sambat\browser
# SESSION_DIR=/var/lib/sambat/browser
# PLAYWRIGHT_SESSION_DIR=   # alias lama, masih dihormati

X_USERNAME=SAMBAT_BJM
X_PASSWORD=
INSTAGRAM_USERNAME=SAMBAT_BJM
INSTAGRAM_PASSWORD=

# ── Import cookies (CARA PALING AMAN — tanpa login otomatis) ────────────────
# Login manual sekali di Chrome/Firefox biasa, lalu ekspor cookies (ekstensi
# Cookie-Editor) dan jalankan: python playwright_collector.py --import-cookies x --file x-cookies.json
# Alternatif tanpa file — isi token penting di sini (X: auth_token & ct0 dari DevTools > Application > Cookies):
# X_AUTH_TOKEN=
# X_CT0=
# INSTAGRAM_SESSIONID=
# INSTAGRAM_CSRFTOKEN=
# INSTAGRAM_DS_USER_ID=

# AI fallback opsional (browser-use) — aktif otomatis saat selector DOM gagal.
# Kosongkan untuk jatuh ke LLM_BASE_URL / LLM_API_KEY / LLM_MODEL dari apps/ai/.env.
# BROWSER_USE_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
# BROWSER_USE_LLM_API_KEY=sk-...
# BROWSER_USE_LLM_MODEL=your-model
# BROWSER_USE_MAX_STEPS=12

# Override opsional kalau navigasi platform berubah:
# X_MENTIONS_URL=https://x.com/SAMBAT_BJM/mentions
# INSTAGRAM_MENTIONS_URL=https://www.instagram.com/
