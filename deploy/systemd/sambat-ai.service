[Unit]
Description=SAMBAT AI Service
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/sambat-repo/apps/ai
ExecStart=/usr/local/lib/hermes-agent/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
